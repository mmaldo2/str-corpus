 {
  "case_id": 5234528,
  "cite": "25 La. Ann. 448",
  "court": "Louisiana Supreme Court",
  "year": 1873,
  "jurisdiction": "La.",
  "relevant": true,
  "relevance_score": 0.4,
  "polarity": "favorable",
  "who_was_letting": "householder",
  "duration_of_occupancy": "months",
  "characterization": "lodging",
  "holding_summary": "In a wife's suit against her husband and his concubine over community property, the court found the concubine's property was largely acquired through her own capital and industry, principally her occupation of keeping a boarding house. The court held she was entitled to her share of the jointly built-up estate as against the husband's community, splitting the property between her separate share and the marital community.",
  "doctrinal_concepts": [
   "boarding_house_keeping",
   "householder_letting_as_lawful_occupation"
  ],
  "new_terms_observed": [],
  "quotes": [
   {
    "text": "Prom the time she went to live with Malady she had no industry except that of keeping a boarding house.",
    "supports": "characterization",
    "status": "verified",
    "raw_span": [
     6140,
     6243
    ],
    "reporter_page": "450"
   },
   {
    "text": "She should be allowed to place her capital and industry against the capital and industry of William Malady, her paramour and copartner, and the property purchased during the time they have been living and working together, should be declared property in which they have a joint interest; one half of it should be decreed to be the property of William Malady, and said half to belong to the community which existed between himself and his lawful wife, Mary Malady.",
    "supports": "holding_summary",
    "status": "verified",
    "raw_span": [
     840,
     1303
    ],
    "reporter_page": "448"
   },
   {
    "text": "That Mary Caldwell should be entitled to keep the proceeds arising from the employment of her patrimony and resulting from her industry, we think is unquestionable. She has a right to it all.",
    "supports": "polarity",
    "status": "verified",
    "raw_span": [
     8465,
     8656
    ],
    "reporter_page": "450"
   }
  ],
  "worker": "claude",
  "batch_id": "cycle-002-shard-01-batch-083",
  "notes": "Case centers on community-property/concubinage law, not on the legal character of the letting itself; boarding-house keeping (including nephews who 'always slept in the house' and draymen boarders at $100/month) is treated in passing as an ordinary lawful income-producing occupation of a householder, which is why it is coded favorable rather than adjudicated on licensing/nuisance grounds.",
  "extraction_status": "ok"
 },
