  "polarity": null,
  "who_was_letting": "commercial_operator",
  "duration_of_occupancy": "nights",
  "characterization": "innkeeping",
  "holding_summary": "The court held that a news agent's selling and delivering of Sunday newspapers is worldly employment not falling within the necessity-or-charity exceptions of the Sunday act of 1794, because a Sunday newspaper is merely a convenience rather than a necessity. In construing that statute's exceptions, the court noted the act's proviso separately shields the operation of 'lodging-houses, inns and other houses of entertainment for the use of sojourners, travelers or strangers' from the general Sunday prohibition.",
  "doctrinal_concepts": [
   "innkeeping",
   "police_power_regulation"
  ],
  "new_terms_observed": [
   "sojourner"
  ],
  "quotes": [
   {
    "text": "lodging-houses, inns and other houses of entertainment for the use of sojourners, travelers or strangers",
    "supports": "characterization",
    "status": "verified",
    "raw_span": [
     5590,
     5694
    ],
    "reporter_page": "168"
   },
   {
    "text": "It is a convenience, nothing more.",
    "supports": "holding_summary",
    "status": "verified",
    "raw_span": [
     8194,
     8228
    ],
    "reporter_page": "169"
   }
  ],
  "worker": "claude",
  "batch_id": "cycle-002-shard-01-batch-136",
  "notes": "Core holding concerns Sunday newspaper sales, not lodging houses; lodging-house/inn language appears in the court's quotation and construction of the 1794 act's proviso exempting such houses for travelers, which is doctrinally relevant to how lodging/innkeeping was categorized under Sunday police-power regulation.",
  "nulled_fields": [
   "polarity"
  ],
