  "polarity": "mixed",
  "who_was_letting": "householder",
  "duration_of_occupancy": "unclear",
  "characterization": "lodging",
  "holding_summary": "The court enjoined a homeowner from operating a beauty parlor business out of her garage as a violation of a residential-use restrictive covenant, distinguishing this from precedent holding that a homeowner's incidental renting of a room to others remains a residential use; that precedent instead requires an injunction only where the dwelling is operated as a rooming/boarding-house business or primarily as a source of financial gain.",
  "doctrinal_concepts": [
   "incidental_letting_as_residential_use",
   "boarding_house_as_business_vs_incidental_use"
  ],
  "new_terms_observed": [],
  "quotes": [
   {
    "text": "This case stands for the proposition that the incidental renting of rooms in a dwelling house, not constituting the operation of a business, is a residential use of the premises.",
    "supports": "characterization",
    "status": "verified",
    "raw_span": [
     7513,
     7691
    ],
    "reporter_page": "504"
   },
   {
    "text": "The court also said that a defendant should be enjoined if he is operating a rooming or boarding house as a business, or is using his dwelling house primarily as a source of financial gain rather than as a residence for himself and his family.",
    "supports": "polarity",
    "status": "verified",
    "raw_span": [
     7072,
     7315
    ],
    "reporter_page": "504"
   },
   {
