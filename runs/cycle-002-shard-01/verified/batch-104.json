  "polarity": "favorable",
  "who_was_letting": "commercial_operator",
  "duration_of_occupancy": "unclear",
  "characterization": "lodging",
  "holding_summary": "Plaintiff, who kept a boarding house, took in and boarded the deceased father's four minor children at the direction of the executor, who orally promised to see her paid. The court held the executor personally and individually liable on that promise, plaintiff's performance in boarding and maintaining the children being sufficient consideration. Judgment for the boarding debt was affirmed.",
  "doctrinal_concepts": [],
  "new_terms_observed": [],
  "quotes": [
   {
    "text": "the defendant, who also was not related to the children, directed the plaintiff who kept a boarding house, to take and keep them, and he would see her paid",
    "supports": "characterization",
    "status": "verified",
    "raw_span": [
     1724,
     1879
    ],
    "reporter_page": "783"
   },
   {
    "text": "The recovery was for the amount owing to the plaintiff for boarding, lodging and otherwise providing for four boys, who were the children of Jesse Combs, deceased.",
    "supports": "holding_summary",
    "status": "verified",
    "raw_span": [
     863,
     1026
    ],
    "reporter_page": "783"
   },
   {
    "text": "Both the judgment and the order should be affirmed.",
    "supports": "polarity",
    "status": "verified",
    "raw_span": [
     6269,
     6320
    ],
    "reporter_page": "784"
   }
  ],
  "worker": "claude",
  "batch_id": "cycle-002-shard-01-batch-104",
  "notes": "Case centers on contract/consideration for the executor's personal promise rather than on the legal character of the boarding arrangement itself, but plaintiff's ordinary business of boarding-house keeping and compensated taking-in of occupants is treated matter-of-factly and the resulting debt enforced by the court.",
  "extraction_status": "ok"
 }
