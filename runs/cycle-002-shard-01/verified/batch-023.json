 {
  "case_id": 1019050,
  "cite": "63 Pa. 406",
  "court": "Supreme Court of Pennsylvania",
  "year": 1870,
  "jurisdiction": "Pa.",
  "relevant": true,
  "relevance_score": 0.4,
  "polarity": null,
  "who_was_letting": "householder",
  "duration_of_occupancy": "months",
  "characterization": "lodging",
  "holding_summary": "In an ejectment brought to enforce specific performance of a contract of sale, the court held the vendor could not bind the vendee by suing only a lodger residing as an inmate of the vendee's family and a tenant occupying a single room of the vendee's house on a monthly rent, because neither represented the vendee's possession of the whole premises. The vendee himself, whose family occupied the dwelling while a lodger and a room-tenant also resided within it, was the person entitled to be made a party and served. The opinion treats the lodger as having no privity of estate or possession, distinguishing her from the room-tenant who held a limited possessory interest by paying rent.",
  "doctrinal_concepts": [
   "lodger_status"
  ],
  "new_terms_observed": [],
  "quotes": [
   {
    "text": "George M. Mickey, the plaintiff's tenant, who also resided in a room of plaintiff's house, on the property, paying a monthly rent",
    "supports": "who_was_letting",
    "status": "verified",
    "raw_span": [
     11663,
     11792
    ],
    "reporter_page": "410"
   },
   {
    "text": "Mrs. Anderson, one of the defendants, was but an inmate of Barclay's family, a mere lodger, having neither privity of estate nor possession.",
    "supports": "characterization",
    "status": "verified",
    "raw_span": [
     22838,
     22978
    ],
    "reporter_page": "414"
   },
   {
    "text": "George Mickey, the other defendant, had no such possession of the premises as would make an ejectment against him alone, an equitable remedy for specific performance.",
    "supports": "holding_summary",
    "status": "verified",
    "raw_span": [
     23128,
     23294
    ],
    "reporter_page": "414"
   }
  ],
  "worker": "claude",
  "batch_id": "cycle-002-shard-01-batch-023",
  "notes": "Core holding is procedural (service/parties in ejectment), but the opinion incidentally treats a householder's family lodger and single-room rent-paying occupant as ordinary, unremarkable arrangements, distinguishing their limited possessory/estate interests from the householder's own possession; low-relevance but doctrinally on-topic.",
  "nulled_fields": [
   "polarity"
  ],
  "extraction_status": "partial"
 },
