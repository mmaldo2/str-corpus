 {
  "case_id": 2599751,
  "cite": "37 La. Ann. 725",
  "court": "Louisiana Supreme Court",
  "year": 1885,
  "jurisdiction": "La.",
  "relevant": true,
  "relevance_score": 0.6,
  "polarity": null,
  "who_was_letting": "householder",
  "duration_of_occupancy": "months",
  "characterization": "lease",
  "holding_summary": "A homesteader who left his dwelling for the summer months on his physician's advice, for reasons of health, did not forfeit his homestead exemption by renting out the premises for that period, since he retained a fixed intention to return and reclaimed the property that fall as agreed. The court held that homestead occupants retain the same right as other citizens to travel and sojourn elsewhere temporarily, in good faith and within reasonable limits, without losing the exemption. The temporary letting of the dwelling during the owner's absence was treated as compatible with continued homestead occupancy.",
  "doctrinal_concepts": [
   "letting_as_incident_of_ownership",
   "temporary_letting_of_dwelling"
  ],
  "new_terms_observed": [],
  "quotes": [
   {
    "text": "he rented his own premises during the summer, with the express stipulation, however, that he was to retake it on the 1st of October",
    "supports": "characterization",
    "status": "verified",
    "raw_span": [
     1427,
     1558
    ],
    "reporter_page": "726"
   },
   {
    "text": "So long as such privilege is exercised in good faith, within reasonable limits and without the intention of changing or abandoning the home, but, on the contrary, with the fixed and certain intention of returning thereto, exemption is not affected thereby.",
    "supports": "holding_summary",
    "status": "verified",
    "raw_span": [
     2796,
     3052
    ],
    "reporter_page": "726"
   }
  ],
  "worker": "claude",
  "batch_id": "cycle-002-shard-01-batch-081",
  "notes": "Householder let his whole dwelling (not merely rooms) for several months during a temporary absence; court treated the letting as an ordinary incident of continued ownership/occupancy that did not defeat homestead status.",
  "nulled_fields": [
   "polarity"
  ],
  "extraction_status": "partial"
 },
