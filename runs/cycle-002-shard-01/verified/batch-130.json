  "duration_of_occupancy": "months",
  "characterization": "lodging",
  "holding_summary": "A person who makes a special contract for board and lodging in another's household is a boarder, not a tenant, and such an arrangement cannot be construed as a leasing of real estate; therefore boarding with a householder for pay does not confer a poor-law settlement by tenancy.",
  "doctrinal_concepts": [
   "lodger_status",
   "license_vs_lease"
  ],
  "new_terms_observed": [],
  "quotes": [
   {
    "text": "One who makes a special contract with another person for board in his family including food and lodging, is not a tenant but a boarder, and by no ingenuity can the contract be construed as a leasing of real estate within the meaning of the statute.",
