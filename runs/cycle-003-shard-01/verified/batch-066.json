 {
  "case_id": 2489543,
  "cite": "109 La. 440",
  "court": "Louisiana Supreme Court",
  "year": 1903,
  "jurisdiction": "La.",
  "relevant": true,
  "relevance_score": 0.55,
  "polarity": null,
  "who_was_letting": "householder",
  "duration_of_occupancy": "months",
  "characterization": "lease",
  "holding_summary": "The court held that Coffee and Smith entered into a completed lease of a house that Coffee intended to use as a boarding house, and that Coffee was Smith's tenant despite never having signed the written lease instrument. Because she abandoned the leased premises without notice, the court found no actionable libel in Smith's letters describing her departure, since their factual statements were substantially true. The court affirmed judgment recognizing the landlord-tenant relationship and awarding the lessor unpaid rent.",
  "doctrinal_concepts": [
   "license_vs_lease"
  ],
  "new_terms_observed": [],
  "quotes": [
   {
    "text": "That in April, 1901, she agreed to rent from defendants a certain house in the town of Covington, provided certain repairs were made thereon, and the house was put in condition for use as a boarding house.",
    "supports": "holding_summary",
    "status": "verified",
    "raw_span": [
     1534,
     1739
    ],
    "reporter_page": "441"
   },
   {
    "text": "We agree with the district judge that the parties entered into a completed contract of lease of the house, and that plaintiff was in possession of the house as tenant when she left the premises,",
    "supports": "characterization",
    "status": "verified",
    "raw_span": [
     8968,
     9162
    ],
    "reporter_page": "443"
   },
   {
    "text": "Plaintiff was a tenant of the defendant. She suddenly left the house, without notice to the lessor.",
    "supports": "holding_summary",
    "status": "verified",
    "raw_span": [
     7237,
     7336
    ],
    "reporter_page": "443"
   }
  ],
  "worker": "claude",
  "batch_id": "cycle-003-shard-01-batch-066",
  "notes": "Owner Smith let an entire house (not merely part of his own dwelling) to Coffee for six months so she could run it as a boarding house; the case concerns the head lease enabling the boarding-house business, not the boarders' own occupancy, so who_was_letting is a qualified 'householder' call.",
  "nulled_fields": [
   "polarity"
  ],
  "extraction_status": "partial"
 },
