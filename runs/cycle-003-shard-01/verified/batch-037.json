  "relevant": true,
  "relevance_score": 0.75,
  "polarity": null,
  "who_was_letting": "householder",
  "duration_of_occupancy": "unclear",
  "characterization": "lodging",
  "holding_summary": "A married woman kept a boarding house at the home where she lived with her husband and boarded the defendant for 1,336 days, including a room kept for him during absences; the court held a complaint pleading a balance due for 'board and lodging' is sufficient to support recovery for the room rent alone, and affirmed the jury's verdict for the plaintiff.",
  "doctrinal_concepts": [
   "lodger_status"
  ],
  "new_terms_observed": [],
  "quotes": [
   {
    "text": "A recovery for rent of a room kept for defendant during long absences may be had under a complaint alleging a balance due for \u201cboard and lodging.\u201d",
    "supports": "characterization",
    "status": "verified",
    "raw_span": [
     230,
     376
    ],
    "reporter_page": "911"
   },
   {
    "text": "The plaintiff gave evidence tending to show that she kept the boarding house on her own account and that the defendant boarded with her 1,336 days, which was worth one dollar per day.",
    "supports": "holding_summary",
    "status": "verified",
    "raw_span": [
     1144,
     1327
    ],
    "reporter_page": "911"
   },
   {
    "text": "The complaint claims for board and lodging. There is a sufficient averment to recover for a room when no board was furnished.",
    "supports": "characterization",
    "status": "verified",
    "raw_span": [
     1508,
     1633
    ],
    "reporter_page": "911"
   }
  ],
  "worker": "claude",
  "batch_id": "cycle-003-shard-01-batch-037",
  "notes": "Duration left unclear: occupancy spanned ~1,336 days (multi-year), which doesn't fit the nights/weeks/months buckets cleanly. Householder ran the boarding house from her own home while residing there with her husband, not as a multi-property commercial enterprise.",
  "nulled_fields": [
   "polarity"
  ],
  "extraction_status": "partial"
 },
