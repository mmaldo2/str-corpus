 {
  "case_id": 963049,
  "cite": "Cummiskey's Estate, 224 Pa. 509",
  "court": "Supreme Court of Pennsylvania",
  "year": 1909,
  "jurisdiction": "Pa.",
  "relevant": true,
  "relevance_score": 0.55,
  "polarity": "favorable",
  "who_was_letting": "householder",
  "duration_of_occupancy": "unclear",
  "characterization": "lodging",
  "holding_summary": "A former domestic servant claimed against the estate of a woman of means for over three years of boarding and nursing furnished in the servant's own home. The court disallowed the claim, holding that boarding and nursing services, like domestic wages, are presumed to be paid at stated periods, and the claimant failed to produce evidence rebutting that presumption despite the decedent's ample means and habit of paying bills promptly.",
  "doctrinal_concepts": [
   "householder_boarding",
   "presumption_of_periodic_payment"
  ],
  "new_terms_observed": [],
  "quotes": [
   {
    "text": "She had her room and took her meals with Mrs. McEvoy\u2019s family, which consisted of her husband and herself.",
    "supports": "characterization",
    "status": "verified",
    "raw_span": [
     4942,
     5048
    ],
    "reporter_page": "511"
   },
   {
    "text": "The same rule is applicable in cases of boarding and nursing under circumstances such as are disclosed in this case.",
    "supports": "holding_summary",
    "status": "verified",
    "raw_span": [
     7536,
     7652
    ],
    "reporter_page": "512"
   },
   {
    "text": "It is a well-established rule that the wages for domestic service are presumed to be paid at stated periods, and that when a claim for such service is presented against a decedent\u2019s estate, extending over any great length Of time, the burden is upon the claimant to rebut the presumption.",
    "supports": "polarity",
    "status": "verified",
    "raw_span": [
     7059,
     7347
    ],
    "reporter_page": "512"
   }
  ],
  "worker": "claude",
  "batch_id": "cycle-003-shard-01-batch-147",
  "notes": "Duration marked unclear because the actual residency spanned roughly three years (164 weeks), outside the nights/weeks/months brackets; the court treats a private householder's paid boarding/lodging arrangement as an ordinary, presumptively-settled economic relationship, analogized to servant's wages.",
  "extraction_status": "ok"
 },
