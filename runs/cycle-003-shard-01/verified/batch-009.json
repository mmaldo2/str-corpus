 {
  "case_id": 8501942,
  "cite": "2 Pelt. 455",
  "court": "Louisiana Court of Appeal",
  "year": 1919,
  "jurisdiction": "La.",
  "relevant": true,
  "relevance_score": 0.62,
  "polarity": "adverse",
  "who_was_letting": "commercial_operator",
  "duration_of_occupancy": "weeks",
  "characterization": "lodging",
  "holding_summary": "The court affirmed judgment for the defendant lessee, holding that a lessor cannot recover rent under a lease he knew at signing was for an unlawful purpose; here the lessor knew the lessee, an unmarried woman taking a house far larger than she needed for herself, intended to run it as a lodging/assignation house outside the city's restricted district fixed by ordinance, and the lease was therefore unenforceable.",
  "doctrinal_concepts": [
   "lodger_status",
   "police_power_licensing"
  ],
  "new_terms_observed": [],
  "quotes": [
   {
    "text": "she could only intend the property as a lodging house",
    "supports": "characterization",
    "status": "verified",
    "raw_span": [
     9160,
     9213
    ],
    "reporter_page": "460"
   },
   {
    "text": "Section 1 of Ordinance No. 6701 N. C. S. adopted August ^\u00a12d, 1910 prescribes the limits of the restricted district, and ^Section 2 makes it unlawful for any person to rent any house to ^lewd woman outside of those limits.",
    "supports": "polarity",
    "status": "verified",
    "raw_span": [
     8604,
     8826
    ],
    "reporter_page": "460"
   },
   {
    "text": "maintain the doctrine that no action arises from a contract of lease when the lessor was aware at the time it was made that the leased premises were to be used for a purpose forbidden by law and whan the premises were so used subsequently.",
    "supports": "holding_summary",
    "status": "verified",
    "raw_span": [
     5202,
     5441
    ],
    "reporter_page": "458"
   }
  ],
  "worker": "claude",
  "batch_id": "cycle-003-shard-01-batch-009",
  "notes": "Marginal adverse authority: a municipal ordinance restricted where a house let out for lodging/assignation use could operate, and the lease was voided on that basis; the underlying use was prostitution rather than ordinary boarding, so weight accordingly.",
  "extraction_status": "ok"
 },
