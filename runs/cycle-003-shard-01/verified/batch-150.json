  "year": 1910,
  "jurisdiction": "Pa.",
  "relevant": true,
  "relevance_score": 0.65,
  "polarity": null,
  "who_was_letting": "unclear",
  "duration_of_occupancy": "months",
  "characterization": "lease",
  "holding_summary": "Plaintiff was in possession of two rooms and a bath in a Philadelphia residence under a written lease at monthly rent paid in advance; the landlord cut off heat and light and altered the building, forcing plaintiff out before the prepaid period expired. The court held a wrongful eviction by a landlord is a trespass on the tenant's rights, entitling the tenant to sue in trespass and recover at least nominal damages, with proof of eviction before the paid period ended sufficient evidence of actual damage for the jury. The compulsory nonsuit was reversed.",
  "doctrinal_concepts": [
   "lease_characterization",
   "wrongful_eviction",
   "landlord_tenant"
  ],
  "new_terms_observed": [],
  "quotes": [
   {
    "text": "At the trial it appeared that the plaintiff occupied two rooms and a bath in a residence in the city of Philadelphia. He was in possession under a written lease at rental of 116.00 per month payable in advance.",
    "supports": "characterization",
    "status": "verified",
    "raw_span": [
     1330,
     1540
    ],
    "reporter_page": "306"
   },
   {
    "text": "One who wrongfully invades the rights of another is a trespasser, and this rule applies to the unlawful invasion of the rights of a tenant by his landlord.",
    "supports": "holding_summary",
    "status": "verified",
    "raw_span": [
     138,
     293
    ],
    "reporter_page": "305"
   }
  ],
  "worker": "claude",
  "batch_id": "cycle-003-shard-01-batch-150",
  "notes": "who_was_letting left unclear: text identifies defendant only as 'the landlord' letting rooms in 'a residence,' with no indication whether letting was as owner-occupant householder or as a commercial rooming-house operator.",
  "nulled_fields": [
   "polarity"
  ],
  "extraction_status": "partial"
 },
