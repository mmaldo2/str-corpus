  "relevance_score": 0.55,
  "polarity": "favorable",
  "who_was_letting": "householder",
  "duration_of_occupancy": "months",
  "characterization": null,
  "holding_summary": "A landlord who lets a dwelling with a sidewalk grating already dangerously out of repair remains liable for injuries the defect causes, notwithstanding an intervening tenancy, because his negligence attaches to the defective condition existing at and before the letting. That liability extended to the plaintiff, a lodger who had rented a room in the house from the landlord's tenant and was hurt by the defect returning home at night. The court affirmed a jury verdict for the injured lodger against the property owner.",
  "doctrinal_concepts": [
   "lodger_status"
  ],
  "new_terms_observed": [],
  "quotes": [
   {
    "text": "The plaintiff, Miss Anna M. Kirchner, a professional masseuse and nurse, rented a room in the house referred to from Mrs. Thompson about September 9, 1901, and remained there until the date of the accident, three months later on.",
    "supports": "who_was_letting",
    "status": "verified",
    "raw_span": [
     8464,
     8693
    ],
    "reporter_page": "435"
   },
   {
    "text": "the mere fact of the tenant\u2019s occupancy when the injury arises, will not relieve the landlord from the consequences of his own negligence. He is liable because of the defective construction or condition at and before the tenancy began, and this liability continues, notwithstanding the possession of the tenant",
    "supports": "holding_summary",
    "status": "verified",
    "raw_span": [
     11145,
     11455
    ],
    "reporter_page": "436"
   },
   {
    "text": "the mere fact of the tenant\u2019s occupancy when the injury arises, will not relieve the landlord from the consequences of his own negligence. He is liable because of the defective construction or condition at and before the tenancy began, and this liability continues, notwithstanding the possession of the tenant",
    "supports": "polarity",
    "status": "verified",
    "raw_span": [
