 {
  "case_id": 7672348,
  "cite": "128 N.Y.S. 1077",
  "court": "New York Supreme Court, Appellate Term",
  "year": 1911,
  "jurisdiction": "N.Y.",
  "relevant": true,
  "relevance_score": 0.6,
  "polarity": "favorable",
  "who_was_letting": "commercial_operator",
  "duration_of_occupancy": "unclear",
  "characterization": "lodging",
  "holding_summary": "The court held that boarding house keepers have a valid lien on a boarder's trunk for unpaid board, defeated only if the amount due is tendered, and reversed a judgment that ordered the trunk released while entering judgment for the boarding house keepers without resolving the disputed tender.",
  "doctrinal_concepts": [
   "lodger_status",
   "innkeepers_lien"
  ],
  "new_terms_observed": [],
  "quotes": [
   {
    "text": "Boarding house keepers have a valid lien on a boarder's trunk, unless the amount due for board is tendered.",
    "supports": "characterization",
    "status": "verified",
    "raw_span": [
     137,
     244
    ],
    "reporter_page": "1077"
   },
   {
    "text": "If she tendered this amount, the defendants are liable for conversion; if she did' not tender it, the defendants had a valid lien up to the amount due them for board furnished.",
    "supports": "polarity",
    "status": "verified",
    "raw_span": [
     1539,
     1715
    ],
    "reporter_page": "1077"
   },
   {
    "text": "The learned trial justice ordered the defendants to give up the trunk, and then gave judgment in their favor.",
    "supports": "holding_summary",
    "status": "verified",
    "raw_span": [
     1832,
     1941
    ],
    "reporter_page": "1077"
   }
  ],
  "worker": "claude",
  "batch_id": "cycle-003-shard-01-batch-125",
  "notes": "Court treats a boarding house keeper's lien on a boarder's property as an established, enforceable commercial right analogous to an innkeeper's lien.",
  "extraction_status": "ok"
 },
